# ─── Ecash upstream — ТОЛЬКО СЕРВЕР ──────────────────────────────
ECASH_API_BASE_URL=https://api-dev.quiq.kz
ECASH_CLIENT_ID=ecash.app.token
# dev-секрет из документации; перед продом РОТИРОВАТЬ у команды Ecash
ECASH_CLIENT_SECRET=
ECASH_HUB_PATH=/appHub
ECASH_TIMEOUT_MS=8000

# ─── Криптография сессии — ТОЛЬКО СЕРВЕР ─────────────────────────
# openssl rand -base64 32
SESSION_SECRET=
# заполняется только на время ротации ключа
SESSION_SECRET_PREVIOUS=

# ─── База данных (наш слой: анкета, избранное, подписки, новости) ─
DATABASE_URL=postgres://ecash:ecash@localhost:5432/ecash

# ─── Безопасность ────────────────────────────────────────────────
APP_ORIGIN=http://localhost:3000

# ─── Публичный адрес сайта ───────────────────────────────────────
# Идёт в sitemap.xml, robots.txt, canonical, hreflang и og-теги.
# NEXT_PUBLIC_ = подставляется в бандл НА СБОРКЕ: в рантайме задать нельзя.
# Для образа передавайте build-arg:
#   docker build --build-arg NEXT_PUBLIC_SITE_URL=https://ваш-домен .
# Без него подставится https://ecash.kz — и чужой прод будет отдавать
# поисковикам этот адрес, молча и без ошибок.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Реальное время ──────────────────────────────────────────────
REALTIME_ENABLED=true

# ─── Скрытые отделения ───────────────────────────────────────────
# depId через запятую — отделения, которые не показываются посетителям
# (ни в списке, ни на карте, ни в выборе при брони).
#
# Нужно для ДЕВ-контура: в api-dev.quiq.kz рядом с настоящими отделениями
# лежат служебные записи — «DEVTEST», «проверка лимитов», «Франшизы».
# Отличить их по данным нельзя: у них есть и адрес, и курсы. Угадывать по
# названию опасно (настоящее отделение может называться как угодно),
# поэтому список задаётся руками.
#
# На БОЕВОМ контуре служебных записей нет — оставьте пустым.
HIDDEN_DEP_IDS=

# ─── Админка новостей: доступ ────────────────────────────────────
# Доступ к разделу /admin привязан к НОМЕРУ ТЕЛЕФОНА. Админ — тот и только
# тот, чей номер перечислен здесь. Отдельных паролей нет: человек входит
# обычным образом через Ecash (пароль или SMS), а номер берётся из живого
# ответа /mobile/account/me и сверяется с этим списком на КАЖДОМ запросе
# к админскому API — см. src/server/admin.ts.
#
# Ролей в Ecash Mobile API нет (проверено 10.08.2026: в JWT только
# scope=mobile-service, в /mobile/account/me — accountId, phoneNumber,
# clientId, iin и ФИО), поэтому номер и есть признак админа.
#
# Несколько администраторов — через запятую. Сравнение идёт по последним
# 10 цифрам, поэтому формат записи любой: +7 775 930 21 88, 87759302188,
# 7759302188 — это один и тот же номер.
#
# Пусто = админов нет, раздел /admin недоступен никому.
# Убрать доступ у человека = убрать его номер отсюда; действует сразу,
# перелогин не нужен.
ADMIN_PHONES=

# ─── Автоперевод новостей (MyMemory) ─────────────────────────────
# Почта владельца стенда. Работает и без неё, но дневная норма — 5 000
# знаков на IP вместо 50 000; при исчерпании редактор показывает ошибку
# квоты, и это выглядит как «перевод иногда отваливается». Наружу не идёт.
# TRANSLATE_EMAIL=

# ─── Push-уведомления в браузере ─────────────────────────────────
# Пара VAPID: `npx web-push generate-vapid-keys`. Без неё push просто
# выключен — карточка подписки не показывается, остальное работает.
# ВАЖНО: пару нельзя менять после запуска — подписки браузеров привязаны
# к прежнему публичному ключу и перестанут приниматься.
# Публичный уходит в браузер (так и задумано), приватным сервер подписывает
# отправку — поэтому БЕЗ префикса NEXT_PUBLIC_.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для служб доставки (Google/Apple) — mailto: или https://
# VAPID_SUBJECT=mailto:info@ecash.kz

# ─── Карта отделений (2GIS MapGL) ─────────────────────────────────
# Ключ MapGL JS API — регистрация и демо-ключ (бесплатно) на
# https://platform.2gis.ru/. БЕЗ КЛЮЧА КАРТА РАБОТАЕТ: BranchMap сам уходит
# на Яндекс.Карты, которым ключ не нужен, — недоступной становится только
# пилюля «2GIS» в переключателе. NEXT_PUBLIC_ — ключ читается в браузере,
# скрипт грузится с mapgl.2gis.com напрямую с клиента, поэтому его тоже
# нужно передавать build-arg'ом при сборке образа.
# NEXT_PUBLIC_DGIS_API_KEY=

# ─── Подсказки адреса (2GIS Suggest API) ──────────────────────────
# ОТДЕЛЬНЫЙ ключ от NEXT_PUBLIC_DGIS_API_KEY выше — Suggest/Places API и
# MapGL JS API это разные продукты на https://platform.2gis.ru/, у каждого
# свой ключ. Без ключа поле «Укажите адрес» просто не показывает подсказки
# (см. /api/geocode/suggest/route.ts) — на карту это не влияет. БЕЗ
# NEXT_PUBLIC_ — ключ читается только на сервере, в браузер не попадает.
# DGIS_SUGGEST_API_KEY=

# ─── Соц-вход ────────────────────────────────────────────────────
# Переменной нет намеренно. Кнопки «Продолжить с Telegram/Google» есть в
# макете, но всегда неактивны и объясняют это подписью: в Ecash Mobile Api
# нет ни одного OAuth-метода. Чтобы их включить, нужны эндпоинты у Ecash и
# обработчики в AuthCard.tsx — переменной окружения тут не хватит.

# ─── Инструменты макета (не нужны для запуска приложения) ────────
FIGMA_TOKEN=
FIGMA_FILE_KEY=
