# ─── Ecash upstream — ТОЛЬКО СЕРВЕР ──────────────────────────────
ECASH_API_BASE_URL=https://api-dev.quiq.kz
ECASH_CLIENT_ID=ecash.app.token
# dev-секрет из документации; перед продом РОТИРОВАТЬ у команды Ecash
ECASH_CLIENT_SECRET=
ECASH_SERVICE_SCOPE=mobile-service
ECASH_HUB_PATH=/appHub
ECASH_TIMEOUT_MS=8000

# ─── Криптография сессии — ТОЛЬКО СЕРВЕР ─────────────────────────
# openssl rand -base64 32
SESSION_SECRET=
# заполняется только на время ротации ключа
SESSION_SECRET_PREVIOUS=

# ─── База данных (наш слой: анкета, избранное, подписки, новости) ─
DATABASE_URL=postgres://ecash:ecash@localhost:5432/ecash

# ─── Безопасность ────────────────────────────────────────────────
APP_ORIGIN=http://localhost:3000

# ─── Реальное время ──────────────────────────────────────────────
REALTIME_ENABLED=true

# ─── Dev-режим ───────────────────────────────────────────────────
# 1 = SMS не отправляются, код показывается в интерфейсе. В проде — 0.
ECASH_OTP_MOCK=0
# Второй, отдельный флаг — только для временных стендов/выставок.
# ECASH_OTP_MOCK=1 в NODE_ENV=production сам по себе всё ещё падает;
# нужны ОБА флага сразу, иначе демо-режим не включится на настоящем проде.
# ALLOW_DEMO_IN_PRODUCTION=1

# ─── Инструменты макета (не нужны для запуска приложения) ────────
FIGMA_TOKEN=
FIGMA_FILE_KEY=
