# ─── Ecash upstream — ТОЛЬКО СЕРВЕР ──────────────────────────────
ECASH_API_BASE_URL=https://api-dev.quiq.kz
ECASH_CLIENT_ID=ecash.app.token
# dev-секрет из документации; перед продом РОТИРОВАТЬ у команды Ecash
ECASH_CLIENT_SECRET=
ECASH_HUB_PATH=/appHub
ECASH_TIMEOUT_MS=8000

# ─── Криптография сессии — ТОЛЬКО СЕРВЕР ─────────────────────────
# openssl rand -base64 32
SESSION_SECRET=
# заполняется только на время ротации ключа
SESSION_SECRET_PREVIOUS=

# ─── База данных (наш слой: анкета, избранное, подписки, новости) ─
DATABASE_URL=postgres://ecash:ecash@localhost:5432/ecash

# ─── Безопасность ────────────────────────────────────────────────
APP_ORIGIN=http://localhost:3000

# ─── Реальное время ──────────────────────────────────────────────
REALTIME_ENABLED=true

# ─── Админка новостей ────────────────────────────────────────────
# Телефоны администраторов через запятую. Вход обычный, через Ecash —
# отдельных паролей нет. Сравнение по последним 10 цифрам, формат любой.
# Пусто = админов нет, раздел /admin недоступен никому.
ADMIN_PHONES=
# В демо-режиме (ECASH_OTP_MOCK=1) войти можно под ЛЮБЫМ номером с общим
# паролем, поэтому знание номера админа = права админа. Из-за этого админка
# в демо-режиме выключена, и включается только этим отдельным флагом.
# ADMIN_IN_DEMO=1

# ─── Dev-режим ───────────────────────────────────────────────────
# 1 = SMS не отправляются, код показывается в интерфейсе. В проде — 0.
ECASH_OTP_MOCK=0
# Второй, отдельный флаг — только для временных стендов/выставок.
# ECASH_OTP_MOCK=1 в NODE_ENV=production сам по себе всё ещё падает;
# нужны ОБА флага сразу, иначе демо-режим не включится на настоящем проде.
# ALLOW_DEMO_IN_PRODUCTION=1

# ─── Карта отделений (2GIS MapGL) ─────────────────────────────────
# Ключ MapGL JS API — регистрация и демо-ключ (бесплатно) на
# https://platform.2gis.ru/. Без ключа карта не грузится вовсе: вместо неё
# показывается пустое состояние (см. BranchMap.tsx). NEXT_PUBLIC_ — ключ
# читается в браузере, скрипт грузится с mapgl.2gis.com напрямую с клиента.
# NEXT_PUBLIC_DGIS_API_KEY=

# ─── Подсказки адреса (2GIS Suggest API) ──────────────────────────
# ОТДЕЛЬНЫЙ ключ от NEXT_PUBLIC_DGIS_API_KEY выше — Suggest/Places API и
# MapGL JS API это разные продукты на https://platform.2gis.ru/, у каждого
# свой ключ. Без ключа поле «Укажите адрес» просто не показывает подсказки
# (см. /api/geocode/suggest/route.ts) — на карту это не влияет. БЕЗ
# NEXT_PUBLIC_ — ключ читается только на сервере, в браузер не попадает.
# DGIS_SUGGEST_API_KEY=

# ─── Соц-вход ────────────────────────────────────────────────────
# Кнопки «Продолжить с Telegram/Google» на форме входа. По умолчанию
# выключены и объясняют это подписью: в Ecash Mobile Api нет ни одного
# OAuth-метода. Включать только вместе с реальными эндпоинтами.
# NEXT_PUBLIC_SOCIAL_AUTH=1

# ─── Инструменты макета (не нужны для запуска приложения) ────────
FIGMA_TOKEN=
FIGMA_FILE_KEY=
